# Copy to catalog/.env and fill in. `catalog/.env` is gitignored; this file is not,
# so it must never carry a real value.
#
# Loaded by every npm script that needs it, through `node --env-file-if-exists=.env`.
# Nothing loads it implicitly: running `node server/index.ts` directly gets the
# shell's environment only, which is how a fully populated .env produced
# "missing_credentials" on every provider at once.
#
# SAVE THIS FILE AS UTF-8 WITHOUT A BOM.
# PowerShell's `>`, `Out-File` and `Set-Content` write a UTF-8 BOM by default. The
# BOM binds to the FIRST variable name in the file and `node --env-file` does not
# strip it, so that one variable is read as "﻿VENOM_..." and every lookup by
# its real name misses — while every other line in the same file works. Run
# `npm run env:check` to be told which name is corrupted rather than guessing.

# Evaluation credentials. One per provider the catalog can evaluate against.
# A provider with no key is not an error: its models are catalogued and scored on
# published facts, and only local evaluation is unavailable.
VENOM_CATALOG_CLINEPASS_API_KEY=
VENOM_CATALOG_OLLAMA_CLOUD_API_KEY=
VENOM_CATALOG_OPENCODE_GO_API_KEY=
VENOM_CATALOG_OPENCODE_ZEN_API_KEY=

# Optional. A SOCKS proxy whitelist URL for evaluation traffic that needs exit
# rotation. The URL itself is a credential — only this NAME is public. Unset
# means rotation is off and evaluation calls go out directly.
VENOM_CATALOG_OPENCODE_ZEN_PROXY_LIST_URL=

# Optional. Overrides for local runs.
# Catalog is a standalone product: the UI and API use separate local ports,
# while Venom Router uses its own control-plane port and never opens this DB.
# CATALOG_DB=data/catalog.db
# PORT=5173
# CATALOG_API=http://127.0.0.1:8791
# Venom Router control plane: http://127.0.0.1:8081
