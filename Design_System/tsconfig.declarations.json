{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".",
    "rootDir": "."
  },
  "include": ["components/**/*.tsx", "components/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-explorer", "**/*.d.ts", "**/*.card.html", "**/*.entry.tsx"]
}
