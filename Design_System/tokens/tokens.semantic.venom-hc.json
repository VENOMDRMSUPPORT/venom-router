{
  "$description": "High Contrast (venom-hc) — complete semantic mapping (identical token set; maximized contrast, thicker focus/borders; targets AAA where feasible).",
  "$theme": "venom-hc",
  "surface": {
    "$type": "color",
    "canvas":   { "$value": "{color.gray.1000}" },
    "primary":  { "$value": "{color.gray.1000}" },
    "secondary":{ "$value": "{color.gray.950}" },
    "raised":   { "$value": "{color.gray.925}" },
    "overlay":  { "$value": "{color.gray.925}" },
    "sunken":   { "$value": "{color.gray.1000}" },
    "inverse":  { "$value": "{color.gray.0}" },
    "scrim":    { "$value": "rgba(0, 0, 0, 0.72)" }
  },
  "text": {
    "$type": "color",
    "primary":   { "$value": "{color.gray.0}" },
    "secondary": { "$value": "{color.gray.100}" },
    "muted":     { "$value": "{color.gray.200}" },
    "disabled":  { "$value": "{color.gray.500}" },
    "inverse":   { "$value": "{color.gray.1000}" },
    "link":       { "$value": "{color.sky.200}" },
    "link-hover": { "$value": "{color.sky.100}" },
    "on-accent": { "$value": "{color.gray.1000}" }
  },
  "border": {
    "$type": "color",
    "subtle":  { "$value": "{color.gray.700}" },
    "default": { "$value": "{color.gray.500}" },
    "strong":  { "$value": "{color.gray.200}" },
    "focus":   { "$value": "{color.gold.200}" }
  },
  "accent": {
    "$type": "color",
    "default":   { "$value": "{color.green.300}" },
    "hover":     { "$value": "{color.green.200}" },
    "active":    { "$value": "{color.green.400}" },
    "subtle-bg": { "$value": "{color.green.900}" },
    "text":      { "$value": "{color.green.200}" }
  },
  "status": {
    "$type": "color",
    "healthy":  { "fg": { "$value": "{color.green.200}" },  "bg": { "$value": "{color.green.900}" },  "border": { "$value": "{color.green.300}" } },
    "degraded": { "fg": { "$value": "{color.orange.200}" }, "bg": { "$value": "{color.orange.900}" }, "border": { "$value": "{color.orange.300}" } },
    "warning":  { "fg": { "$value": "{color.amber.200}" },  "bg": { "$value": "{color.amber.900}" },  "border": { "$value": "{color.amber.300}" } },
    "critical": { "fg": { "$value": "{color.red.200}" },    "bg": { "$value": "{color.red.900}" },    "border": { "$value": "{color.red.300}" } },
    "info":     { "fg": { "$value": "{color.blue.200}" },   "bg": { "$value": "{color.blue.900}" },   "border": { "$value": "{color.blue.300}" } },
    "unknown":  { "fg": { "$value": "{color.gray.100}" },   "bg": { "$value": "{color.gray.850}" },   "border": { "$value": "{color.gray.300}" } },
    "inactive": { "fg": { "$value": "{color.gray.300}" },   "bg": { "$value": "{color.gray.900}" },   "border": { "$value": "{color.gray.600}" } }
  },
  "action": {
    "$type": "color",
    "primary": {
      "bg":        { "$value": "{accent.default}" },
      "bg-hover":  { "$value": "{accent.hover}" },
      "bg-active": { "$value": "{accent.active}" },
      "fg":        { "$value": "{text.on-accent}" }
    },
    "secondary": {
      "bg":       { "$value": "{color.gray.925}" },
      "bg-hover": { "$value": "{color.gray.850}" },
      "border":   { "$value": "{color.gray.200}" },
      "fg":       { "$value": "{color.gray.0}" }
    },
    "destructive": {
      "bg":       { "$value": "{color.red.300}" },
      "bg-hover": { "$value": "{color.red.200}" },
      "fg":       { "$value": "{color.gray.1000}" }
    },
    "ghost":    { "bg-hover": { "$value": "{color.gray.850}" } },
    "disabled": { "bg": { "$value": "{color.gray.900}" }, "fg": { "$value": "{color.gray.500}" } }
  },
  "focus": {
    "ring":        { "$type": "color", "$value": "{color.gold.200}" },
    "ring-width":  { "$type": "dimension", "$value": "3px" },
    "ring-offset": { "$type": "dimension", "$value": "2px" }
  },
  "selection": {
    "$type": "color",
    "bg": { "$value": "{color.green.200}" },
    "fg": { "$value": "{color.gray.1000}" }
  },
  "tier": {
    "$type": "color",
    "lite": { "fg": { "$value": "{color.sky.200}" },    "bg": { "$value": "{color.sky.900}" },    "border": { "$value": "{color.sky.300}" } },
    "pro":  { "fg": { "$value": "{color.violet.200}" }, "bg": { "$value": "{color.violet.900}" }, "border": { "$value": "{color.violet.300}" } },
    "max":  { "fg": { "$value": "{color.gold.200}" },   "bg": { "$value": "{color.gold.900}" },   "border": { "$value": "{color.gold.300}" } }
  },
  "elevation": {
    "$type": "shadow",
    "card":    { "$value": "none" },
    "popover": { "$value": "0 6px 16px rgba(0,0,0,0.60)" },
    "modal":   { "$value": "0 12px 32px rgba(0,0,0,0.70)" },
    "toast":   { "$value": "0 6px 16px rgba(0,0,0,0.60)" }
  },
  "viz": {
    "$type": "color",
    "cat": {
      "1": { "$value": "{color.sky.200}" },
      "2": { "$value": "{color.violet.200}" },
      "3": { "$value": "{color.gold.200}" },
      "4": { "$value": "{color.green.200}" },
      "5": { "$value": "{color.blue.200}" },
      "6": { "$value": "{color.orange.200}" },
      "7": { "$value": "{color.red.200}" },
      "8": { "$value": "{color.gray.200}" }
    },
    "seq": {
      "1": { "$value": "{color.green.900}" },
      "2": { "$value": "{color.green.800}" },
      "3": { "$value": "{color.green.700}" },
      "4": { "$value": "{color.green.500}" },
      "5": { "$value": "{color.green.400}" },
      "6": { "$value": "{color.green.300}" },
      "7": { "$value": "{color.green.200}" }
    }
  }
}
