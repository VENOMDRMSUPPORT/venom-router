{
  "$description": "Venom Light — complete semantic mapping (identical token set to venom-dark; light values).",
  "$theme": "venom-light",
  "surface": {
    "$type": "color",
    "canvas":   { "$value": "{color.gray.0}" },
    "primary":  { "$value": "{color.gray.25}" },
    "secondary":{ "$value": "{color.gray.50}" },
    "raised":   { "$value": "{color.gray.0}" },
    "overlay":  { "$value": "{color.gray.0}" },
    "sunken":   { "$value": "{color.gray.100}" },
    "inverse":  { "$value": "{color.gray.900}" },
    "scrim":    { "$value": "rgba(11, 15, 18, 0.45)" }
  },
  "text": {
    "$type": "color",
    "primary":   { "$value": "{color.gray.900}" },
    "secondary": { "$value": "{color.gray.700}" },
    "muted":     { "$value": "{color.gray.600}" },
    "disabled":  { "$value": "{color.gray.400}" },
    "inverse":   { "$value": "{color.gray.0}" },
    "link":       { "$value": "{color.green.700}" },
    "link-hover": { "$value": "{color.green.800}" },
    "on-accent": { "$value": "{color.gray.0}" }
  },
  "border": {
    "$type": "color",
    "subtle":  { "$value": "{color.gray.100}" },
    "default": { "$value": "{color.gray.200}" },
    "strong":  { "$value": "{color.gray.500}" },
    "focus":   { "$value": "{color.green.600}" }
  },
  "accent": {
    "$type": "color",
    "default":   { "$value": "{color.green.700}" },
    "hover":     { "$value": "{color.green.800}" },
    "active":    { "$value": "{color.green.900}" },
    "subtle-bg": { "$value": "{color.green.100}" },
    "text":      { "$value": "{color.green.700}" }
  },
  "status": {
    "$type": "color",
    "healthy":  { "fg": { "$value": "{color.green.700}" },  "bg": { "$value": "{color.green.100}" },  "border": { "$value": "{color.green.300}" } },
    "degraded": { "fg": { "$value": "{color.orange.700}" }, "bg": { "$value": "{color.orange.100}" }, "border": { "$value": "{color.orange.300}" } },
    "warning":  { "fg": { "$value": "{color.amber.700}" },  "bg": { "$value": "{color.amber.100}" },  "border": { "$value": "{color.amber.300}" } },
    "critical": { "fg": { "$value": "{color.red.700}" },    "bg": { "$value": "{color.red.100}" },    "border": { "$value": "{color.red.300}" } },
    "info":     { "fg": { "$value": "{color.blue.700}" },   "bg": { "$value": "{color.blue.100}" },   "border": { "$value": "{color.blue.300}" } },
    "unknown":  { "fg": { "$value": "{color.gray.700}" },   "bg": { "$value": "{color.gray.100}" },   "border": { "$value": "{color.gray.400}" } },
    "inactive": { "fg": { "$value": "{color.gray.600}" },   "bg": { "$value": "{color.gray.50}" },    "border": { "$value": "{color.gray.200}" } }
  },
  "action": {
    "$type": "color",
    "primary": {
      "bg":        { "$value": "{accent.default}" },
      "bg-hover":  { "$value": "{accent.hover}" },
      "bg-active": { "$value": "{accent.active}" },
      "fg":        { "$value": "{text.on-accent}" }
    },
    "secondary": {
      "bg":       { "$value": "{color.gray.0}" },
      "bg-hover": { "$value": "{color.gray.50}" },
      "border":   { "$value": "{color.gray.300}" },
      "fg":       { "$value": "{text.primary}" }
    },
    "destructive": {
      "bg":       { "$value": "{color.red.600}" },
      "bg-hover": { "$value": "{color.red.700}" },
      "fg":       { "$value": "{color.gray.0}" }
    },
    "ghost":    { "bg-hover": { "$value": "{color.gray.100}" } },
    "disabled": { "bg": { "$value": "{color.gray.100}" }, "fg": { "$value": "{color.gray.400}" } }
  },
  "focus": {
    "ring":        { "$type": "color", "$value": "{color.green.600}" },
    "ring-width":  { "$type": "dimension", "$value": "2px" },
    "ring-offset": { "$type": "dimension", "$value": "2px" }
  },
  "selection": {
    "$type": "color",
    "bg": { "$value": "{color.green.100}" },
    "fg": { "$value": "{color.gray.900}" }
  },
  "tier": {
    "$type": "color",
    "lite": { "fg": { "$value": "{color.sky.700}" },    "bg": { "$value": "{color.sky.100}" },    "border": { "$value": "{color.sky.300}" } },
    "pro":  { "fg": { "$value": "{color.violet.700}" }, "bg": { "$value": "{color.violet.100}" }, "border": { "$value": "{color.violet.300}" } },
    "max":  { "fg": { "$value": "{color.gold.700}" },   "bg": { "$value": "{color.gold.100}" },   "border": { "$value": "{color.gold.300}" } }
  },
  "elevation": {
    "$type": "shadow",
    "card":    { "$value": "0 1px 3px rgba(16,24,32,0.10), 0 1px 2px rgba(16,24,32,0.06)" },
    "popover": { "$value": "0 8px 24px rgba(16,24,32,0.16)" },
    "modal":   { "$value": "0 16px 48px rgba(16,24,32,0.22)" },
    "toast":   { "$value": "0 8px 24px rgba(16,24,32,0.18)" }
  },
  "viz": {
    "$type": "color",
    "cat": {
      "1": { "$value": "{color.sky.600}" },
      "2": { "$value": "{color.violet.600}" },
      "3": { "$value": "{color.gold.600}" },
      "4": { "$value": "{color.green.600}" },
      "5": { "$value": "{color.blue.600}" },
      "6": { "$value": "{color.orange.600}" },
      "7": { "$value": "{color.red.600}" },
      "8": { "$value": "{color.gray.600}" }
    },
    "seq": {
      "1": { "$value": "{color.green.100}" },
      "2": { "$value": "{color.green.200}" },
      "3": { "$value": "{color.green.300}" },
      "4": { "$value": "{color.green.400}" },
      "5": { "$value": "{color.green.500}" },
      "6": { "$value": "{color.green.600}" },
      "7": { "$value": "{color.green.700}" }
    }
  }
}
