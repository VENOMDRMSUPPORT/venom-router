  "space": {
    "$type": "dimension",
    "0":  { "$value": "0px" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Every scale step routes through the ONE runtime base custom property --vn-radius-base (default 6px; set via applyRadius from src/customizer.ts, clamped 0-16px). Unset, the computed values are exactly the historical scale (2/4/6/8/12/16px). `full` stays literal: it is reserved for status dots and count pills, which must remain round at any base radius.",
    "xs":   { "$value": "calc(var(--vn-radius-base, 6px) * 2 / 6)" },
    "sm":   { "$value": "calc(var(--vn-radius-base, 6px) * 4 / 6)" },
    "md":   { "$value": "var(--vn-radius-base, 6px)" },
    "lg":   { "$value": "calc(var(--vn-radius-base, 6px) * 8 / 6)" },
    "xl":   { "$value": "calc(var(--vn-radius-base, 6px) * 12 / 6)" },
    "2xl":  { "$value": "calc(var(--vn-radius-base, 6px) * 16 / 6)" },
    "full": { "$value": "999px" }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "thick":    { "$value": "2px" },
    "heavy":    { "$value": "3px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui":   { "$value": "'IBM Plex Sans', 'Segoe UI', system-ui, sans-serif" },
      "mono": { "$value": "'IBM Plex Mono', 'Cascadia Mono', 'Consolas', monospace" }
    },
    "size": {
      "$type": "dimension",
      "2xs": { "$value": "11px" },
      "xs":  { "$value": "12px" },
      "sm":  { "$value": "13px" },
      "md":  { "$value": "14px" },
      "lg":  { "$value": "16px" },
      "xl":  { "$value": "18px" },
      "2xl": { "$value": "20px" },
      "3xl": { "$value": "24px" },
      "4xl": { "$value": "30px" },
      "5xl": { "$value": "38px" },
      "6xl": { "$value": "46px" },
      "7xl": { "$value": "56px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold":     { "$value": "700" }
    },
    "line-height": {
      "$type": "number",
      "tight":  { "$value": "1.2" },
      "snug":   { "$value": "1.35" },
      "normal": { "$value": "1.5" },
      "loose":  { "$value": "1.65" }
    },
    "tracking": {
      "$type": "dimension",
      "normal": { "$value": "0" },
      "wide":   { "$value": "0.04em" },
      "wider":  { "$value": "0.08em" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "0": { "$value": "none" },
    "1": { "$value": "0 1px 2px rgba(0,0,0,0.24)" },
    "2": { "$value": "0 2px 6px rgba(0,0,0,0.28)" },
    "3": { "$value": "0 6px 16px rgba(0,0,0,0.32)" },
    "4": { "$value": "0 12px 32px rgba(0,0,0,0.38)" },
    "5": { "$value": "0 20px 48px rgba(0,0,0,0.44)" }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "0ms" },
    "fast":    { "$value": "100ms" },
    "base":    { "$value": "160ms" },
    "slow":    { "$value": "240ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard":   { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "emphasized": { "$value": "cubic-bezier(0.3, 0, 0, 1)" },
    "exit":       { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "z": {
    "$type": "number",
    "base":     { "$value": "0" },
    "sticky":   { "$value": "100" },
    "dropdown": { "$value": "200" },
    "overlay":  { "$value": "300" },
    "modal":    { "$value": "400" },
    "toast":    { "$value": "500" },
    "max":      { "$value": "999" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm":  { "$value": "640px" },
    "md":  { "$value": "900px" },
    "lg":  { "$value": "1200px" },
    "xl":  { "$value": "1440px" },
    "2xl": { "$value": "1760px" }
  }
}
