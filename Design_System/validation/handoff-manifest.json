{
  "$comment": "Machine-readable handoff manifest for the Venom Design System. Enforced by validation/check-handoff.cjs (a gate in `npm run validate`). Paths are repository-relative; a trailing slash marks a directory. Every top-level entry of the package must be classified here — an unclassified newcomer fails the gate.",
  "authored": [
    ".gitignore",
    "README.md",
    "SKILL.md",
    "accessibility/",
    "components/",
    "css/",
    "foundations/",
    "icons/icon-map.md",
    "package.json",
    "package-lock.json",
    "patterns/",
    "scripts/",
    "src/",
    "states/",
    "storybook/",
    "styles.css",
    "tests/",
    "tokens/base.css",
    "tokens/fonts.css",
    "tokens/tokens.component.json",
    "tokens/tokens.density.json",
    "tokens/tokens.primitive.json",
    "tokens/tokens.semantic.venom-dark.json",
    "tokens/tokens.semantic.venom-hc.json",
    "tokens/tokens.semantic.venom-light.json",
    "tsconfig.build.json",
    "tsconfig.declarations.json",
    "tsconfig.json",
    "ui_kits/",
    "validation/build-tokens.cjs",
    "validation/check-contrast.cjs",
    "validation/check-guardrails.cjs",
    "validation/check-handoff.cjs",
    "validation/handoff-contract.md",
    "validation/handoff-manifest.json",
    "validation/shots/",
    "vite.config.ts",
    "vite.explorer.config.ts"
  ],
  "generated_required": [
    "assets/icons/",
    "icons/icons.css",
    "themes/venom-dark.css",
    "themes/venom-light.css",
    "themes/venom-hc.css",
    "tokens/primitives.css",
    "tokens/components.css",
    "tokens/density.css",
    "tokens/tokens.ts",
    "tokens/tailwind-theme.ts",
    "components/**/*.d.ts",
    "validation/theme-token-manifest.json",
    "validation/report.json",
    "validation/report.md"
  ],
  "generated_reproducible": [
    "dist/",
    "dist-explorer/"
  ],
  "test_baselines": [
    "tests/visual/snapshots.spec.ts-snapshots/"
  ],
  "excluded": [
    "node_modules/",
    "dist/",
    "dist-explorer/",
    "test-results/",
    "playwright-report/",
    "blob-report/",
    ".playwright/",
    "coverage/",
    ".cache/",
    ".vite/",
    "tmp/",
    "temp/",
    "*.log"
  ],
  "canonical_sources": {
    "components": ["components/"],
    "entry_points": ["src/"],
    "tokens": [
      "tokens/tokens.primitive.json",
      "tokens/tokens.semantic.venom-dark.json",
      "tokens/tokens.semantic.venom-light.json",
      "tokens/tokens.semantic.venom-hc.json",
      "tokens/tokens.component.json",
      "tokens/tokens.density.json"
    ],
    "token_compiler": ["validation/build-tokens.cjs"],
    "icons": ["icons/icons.css", "components/icons/Icon.tsx", "icons/icon-map.md"],
    "explorer": ["storybook/index.html", "vite.explorer.config.ts"],
    "compositions": ["ui_kits/venom-console/"],
    "declaration_configs": ["tsconfig.declarations.json", "tsconfig.build.json"],
    "tests": ["tests/"],
    "validation": ["scripts/validate.js"]
  },
  "forbidden_stale": [
    "src/*.d.ts",
    "**/*.entry.d.ts",
    "**/*.jsx",
    "storybook/card-runtime.js",
    "validation/_gate-*.json",
    "dist/.export-check.mjs"
  ],
  "regeneration_commands": {
    "tokens/primitives.css, tokens/components.css, tokens/density.css, tokens/tokens.ts, tokens/tailwind-theme.ts, themes/*.css, validation/theme-token-manifest.json": "npm run validate (gate 1: validation/build-tokens.cjs)",
    "components/**/*.d.ts": "npm run build:declarations",
    "assets/icons/, icons/icons.css (local path rewrite)": "npm run vendor:icons",
    "dist/": "npm run build (or build:types + build:lib)",
    "dist-explorer/": "npm run build:explorer",
    "validation/report.json, validation/report.md": "npm run validate",
    "tests/visual/snapshots.spec.ts-snapshots/": "npm run test:visual:update (ONLY on an intended, reviewed visual change)"
  }
}
