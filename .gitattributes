# Auto detect text files and perform LF normalization
* text=auto

# TypeScript/JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf

# Denote these files as binary (do not normalize)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
